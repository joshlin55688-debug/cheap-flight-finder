# ===== Skyscanner 機場搜尋 (透過 RapidAPI Sky-Scrapper) =====
# 申請地址: https://rapidapi.com/apiheya/api/sky-scrapper
RAPIDAPI_KEY=your_rapidapi_key_here

# ===== Google Flights (透過 SerpApi) =====
# 申請地址: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# ===== Travelpayouts (Skyscanner 票價，可選) =====
# 申請地址: https://www.travelpayouts.com/ → 登入 → Tools → API
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here

# ===== Server =====
PORT=3000
